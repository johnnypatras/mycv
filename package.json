{
  "name": "ialexopoulos-org",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual personal CV site. All content lives in data/cv.json.",
  "scripts": {
    "build": "node build.mjs",
    "build:fast": "node build.mjs --no-pdf",
